# AUDIT: xac nhan da tham dinh script
$log = "..\data\log-he-thong.log"
$out = "..\backup\bao-cao-su-co.txt"

Write-Output "BAO CAO SU CO SMARTFARM" > $out
Write-Output "Ngay gio: $(Get-Date)" >> $out

Get-Content $log | Select-String "CRITICAL|ERROR" >> $out

Write-Output "TONG SO SU CO:" >> $out
@(Get-Content $log | Select-String "CRITICAL|ERROR").Count >> $out
